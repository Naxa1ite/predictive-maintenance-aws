# Copy to .env (git-ignored) or export in your shell. Never put access keys here:
# credentials come from the AWS CLI profile created with `aws configure --profile pm-project`.
AWS_PROFILE=pm-project
AWS_REGION=ap-south-1
STACK_NAME=pm-aws
PROJECT_NAME=pm-aws          # prefix for resource names, 3-20 lowercase letters/digits/hyphens
ALERT_EMAIL=                 # address that receives high-risk alerts (must confirm the SNS email)
ALERT_THRESHOLD=             # optional probability 0-1; empty = model decision threshold
API_URL=                     # filled in after deployment, used by simulator/simulator.py
